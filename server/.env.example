# Copy to .env and fill in for your environment, then run:
#   node --env-file=.env index.js

PORT=3000

# Must match infra/turnserver.conf on the same Local Server. A domain
# resolves the same from the LAN and the public internet, so once one
# exists (Stage 5+) prefer it over a bare IP — e.g. turn:your.domain:3478.
# LAN-only dev without a domain yet: use the VM's LAN IP instead.
# If deploying behind Cloudflare's proxy (see infra/README.md's
# "Cloudflare proxy + Caddy on 443"), this must be a SEPARATE, unproxied
# subdomain (e.g. turn:turn.your.domain:3478) — TURN can never go through
# Cloudflare's proxy, so it needs a DNS record that isn't proxied either.
TURN_URI=turn:192.168.1.50:3478
TURN_SECRET=CHANGE_ME_SHARED_SECRET
TURN_CRED_TTL_SECONDS=3600

# Auto-terminates a live link if the client doesn't stop it manually.
SESSION_TIMEOUT_MINUTES=60

# Login for /studio and /admin — two fixed accounts, username is the role
# name ("studio" / "admin"). Generate a hash with:
#   node server/hash-password.js '<password>'
STUDIO_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
AUTH_SESSION_HOURS=12
